
SPEED = quick

.speed.quick = $(sort $(filter-out %-slow %-thorough, $1))
.speed.slow = $(sort $(filter-out %-thorough, $1))
.speed.thorough = $(sort $1)

TIMEOUT_MULTIPLIER ?= 1
.mtestargs = --no-rebuild -t $(TIMEOUT_MULTIPLIER)
ifneq ($(SPEED), quick)
.mtestargs += --setup $(SPEED)
endif
.mtestargs += $(subst -j,--num-processes , $(filter-out -j, $(lastword -j1 $(filter -j%, $(MAKEFLAGS)))))

.check.mtestargs = $(MTESTARGS) $(.mtestargs) $(if $(V),--verbose,--print-errorlogs) \
    $(foreach s, $(sort $(.check.mtest-suites)), --suite $s)
.bench.mtestargs = $(MTESTARGS) $(.mtestargs) --benchmark --verbose \
    $(foreach s, $(sort $(.bench.mtest-suites)), --suite $s)

all-check-targets = check-func-thorough check-func check-func-aarch64-thorough check-func-aarch64 check-func-ppc64-thorough check-func-ppc64 check-qtest check-qtest-x86_64 check-qtest-i386 check-qtest-aarch64 check-qtest-riscv64 check-qtest-arm check-qtest-ppc check-qtest-ppc64 check-func-arm-thorough check-func-arm check-func-x86_64-thorough check-func-x86_64 check-unit check-func-ppc-thorough check-func-ppc check-func-riscv64-thorough check-func-riscv64 check-func-quick check-func-i386 check-func-i386-thorough check-qapi-schema check-qapi-interop check-decodetree check-softfloat check-softfloat-conv check-softfloat-compare check-softfloat-ops check-softfloat-slow check-softfloat-ops-slow check-qapi-frontend check-tracetool
all-check-xml = check-report-func-thorough.junit.xml check-report-func.junit.xml check-report-func-aarch64-thorough.junit.xml check-report-func-aarch64.junit.xml check-report-func-ppc64-thorough.junit.xml check-report-func-ppc64.junit.xml check-report-qtest.junit.xml check-report-qtest-x86_64.junit.xml check-report-qtest-i386.junit.xml check-report-qtest-aarch64.junit.xml check-report-qtest-riscv64.junit.xml check-report-qtest-arm.junit.xml check-report-qtest-ppc.junit.xml check-report-qtest-ppc64.junit.xml check-report-func-arm-thorough.junit.xml check-report-func-arm.junit.xml check-report-func-x86_64-thorough.junit.xml check-report-func-x86_64.junit.xml check-report-unit.junit.xml check-report-func-ppc-thorough.junit.xml check-report-func-ppc.junit.xml check-report-func-riscv64-thorough.junit.xml check-report-func-riscv64.junit.xml check-report-func-quick.junit.xml check-report-func-i386.junit.xml check-report-func-i386-thorough.junit.xml check-report-qapi-schema.junit.xml check-report-qapi-interop.junit.xml check-report-decodetree.junit.xml check-report-softfloat.junit.xml check-report-softfloat-conv.junit.xml check-report-softfloat-compare.junit.xml check-report-softfloat-ops.junit.xml check-report-softfloat-slow.junit.xml check-report-softfloat-ops-slow.junit.xml check-report-qapi-frontend.junit.xml check-report-tracetool.junit.xml
.PHONY: check do-meson-check check-report.junit.xml $(all-check-targets) $(all-check-xml)
ninja-cmd-goals += $(foreach s, $(.check.mtest-suites), $(.check-$s.deps))
check-build: run-ninja
check $(all-check-targets): do-meson-check
do-meson-check: run-ninja; $(if $(MAKE.n),,+)$(MESON) test $(.check.mtestargs)
check-report.junit.xml $(all-check-xml): check-report%.junit.xml: run-ninja
	$(MAKE) check$* MTESTARGS="$(MTESTARGS) --logbase check-report$*" && ln -f meson-logs/$@ .

.check-func-thorough.deps = tests/tcg/plugins/libmem.dylib tests/tcg/plugins/libempty.dylib contrib/plugins/libexeclog.dylib pc-bios/edk2-loongarch64-vars.fd contrib/plugins/libips.dylib contrib/plugins/libstoptrigger.dylib contrib/plugins/libcflow.dylib tests/tcg/plugins/libinline.dylib tests/tcg/plugins/libsetpc.dylib pc-bios/edk2-arm-code.fd pc-bios/edk2-x86_64-secure-code.fd pc-bios/edk2-i386-secure-code.fd qemu-system-ppc contrib/plugins/libhotblocks.dylib pc-bios/edk2-i386-vars.fd pc-bios/edk2-riscv-code.fd pc-bios/edk2-riscv-vars.fd qemu-system-riscv64 tests/tcg/plugins/libreset.dylib tests/tcg/plugins/libbb.dylib tests/tcg/plugins/libdiscons.dylib contrib/plugins/libcache.dylib contrib/plugins/libbbv.dylib tests/tcg/plugins/libinsn.dylib pc-bios/edk2-aarch64-code.fd pc-bios/edk2-loongarch64-code.fd contrib/plugins/libhwprofile.dylib contrib/plugins/libtraps.dylib contrib/plugins/libcpp.dylib tests/tcg/plugins/libregisters.dylib tests/tcg/plugins/libsyscall.dylib pc-bios/edk2-i386-code.fd pc-bios/edk2-x86_64-code.fd qemu-system-aarch64 tests/tcg/plugins/libpatch.dylib qemu-system-ppc64 pyvenv/functests.group contrib/plugins/libhotpages.dylib contrib/plugins/libhowvec.dylib contrib/plugins/libuftrace.dylib qemu-system-x86_64 qemu-system-i386 qemu-img contrib/plugins/liblockstep.dylib contrib/plugins/libdrcov.dylib pc-bios/edk2-arm-vars.fd qemu-system-arm
.ninja-goals.check-build += $(.check-func-thorough.deps)
ifneq ($(filter check-func-thorough check-report-func-thorough.junit.xml, $(MAKECMDGOALS)),)
.check.mtest-suites += func-thorough $(call .speed.$(SPEED), )
endif

.check-func.deps = 
.ninja-goals.check-build += $(.check-func.deps)
ifneq ($(filter check-func check-report-func.junit.xml check check-report.junit.xml, $(MAKECMDGOALS)),)
.check.mtest-suites += func $(call .speed.$(SPEED), func-thorough)
endif

